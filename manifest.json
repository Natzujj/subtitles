{
  "manifest_version": 3,
  "name": "Real-Time Subtitles",
  "version": "0.1.0",
  "description": "Legendas em tempo real do áudio de uma aba, usando Vosk rodando localmente.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Legendas ao Vivo"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
    "icons": {
    "128": "icons/icon.png"
  }
}